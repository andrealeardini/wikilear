{% extends "layouts/base.njk" %}

{% block content %}

<div class="grid grid-cols-1 md:grid-cols-4 gap-8">

  {# Main content column #}
  <div class="md:col-span-3">
    <article>
      {%- include "partials/page-header.njk" -%}
      <div class="{{ style }}">
        {{ content | safe }}
      </div>
      
      {% if tags %}
      <p class="mt-8 font-semibold" id="tags-desc">
        Etichette
      </p>
      <div class="mb-6" aria-describedby="tags-desc">
        {%- include "components/tags-post.njk" -%}
      </div>
      {% endif %}
      
      {%- include "components/share.njk" -%}
      
      <hr class="mt-8 mb-4">
      {%- include "components/editthispage.njk" -%}
      <hr class="mt-4 mb-4">

    </article>
  </div>

  {# Backdrop for mobile #}
  <div id="pwa-sidebar-backdrop" class="fixed inset-0 bg-black/10 backdrop-blur-sm z-30 hidden md:hidden"></div>

  {# Sidebar column #}
  <div id="pwa-sidebar" class="fixed top-16 right-0 bottom-0 w-72 bg-gray-100 dark:bg-gray-800 shadow-lg transform translate-x-full transition-transform duration-300 ease-in-out z-40 md:relative md:top-auto md:bottom-auto md:translate-x-0 md:col-span-1 md:bg-transparent md:dark:bg-transparent md:shadow-none">
    <div class="p-4">
      <button id="pwa-sidebar-close" type="button" class="md:hidden absolute top-2 right-2 p-2" aria-label="Chiudi menu del corso">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
      </button>
      {% include "components/pwa-course/sidebar.njk" %}
    </div>
  </div>

</div>
{% endblock %}

{% block page_scripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('pwa-sidebar-toggle');
    const closeBtn = document.getElementById('pwa-sidebar-close');
    const sidebar = document.getElementById('pwa-sidebar');
    const backdrop = document.getElementById('pwa-sidebar-backdrop');

    function openSidebar() {
      sidebar.classList.remove('translate-x-full');
      backdrop.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
    }

    function closeSidebar() {
      sidebar.classList.add('translate-x-full');
      backdrop.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }

    toggleBtn.addEventListener('click', openSidebar);
    closeBtn.addEventListener('click', closeSidebar);
    backdrop.addEventListener('click', closeSidebar);
  });
</script>
{% endblock %}